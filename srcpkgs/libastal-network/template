# Template file for 'astal'
pkgname=libastal-network
version=0.2.0
revision=1
build_style=meson
build_helper="gir"
hostmakedepends="gobject-introspection pkg-config vala valadoc"
makedepends="glib-devel NetworkManager-devel"
depends="libastal NetworkManager"
short_desc="Building blocks for creating custom desktop shells"
maintainer="Aylur"
license="LGPL-2.1"
homepage="https://aylur.github.io/astal/"
distfiles="https://github.com/Aylur/astal/archive/2c5eb54f39e1710c6e2c80915a240978beb3269a.zip"
checksum=52d18ddcbc9fc83c3aaed80c72e00cc917cd962a65d5bb69aaf54c96bf9453d8

do_configure() {
	cd lib/network
	meson setup --prefix=/usr build
}

do_build() {
	cd lib/network
	meson compile -C build
}

do_install() {
	cd lib/network
	DESTDIR=${DESTDIR} meson install -C build
}

post_install() {
	vlicense LICENSE
}
