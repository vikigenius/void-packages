# Template file for 'astal'
pkgname=libastal-io
version=0.1.0
revision=1
build_style=meson
build_helper="gir"
hostmakedepends="gobject-introspection pkg-config vala valadoc"
makedepends="gtk+3-devel gtk-layer-shell-devel"
short_desc="Building blocks for creating custom desktop shells "
maintainer="Aylur"
license="LGPL-2.1"
homepage="https://aylur.github.io/astal/"
distfiles="https://github.com/Aylur/astal/archive/4820a3e37cc8eb81db6ed991528fb23472a8e4de.zip"
checksum=9d9b35ecb10d6a6c6c34a22b9f37c87e0719129bc2a7a636bc26b2b468f431c4
shlib_provides="libastal-io.so.0"

do_configure() {
	cd lib/astal/io
	meson setup --prefix=/usr build
}

do_build() {
	cd lib/astal/io
	meson compile -C build
}

do_install() {
	cd lib/astal/io
	DESTDIR=${DESTDIR} meson install -C build
}

post_install() {
	vlicense LICENSE
}
